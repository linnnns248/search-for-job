{
  "manifest_version": 3,
  "name": "成都岗位采集助手",
  "version": "0.2.1",
  "description": "在普通 Chrome 登录状态下定时采集 Boss 公开岗位，并发送给本地岗位看板。",
  "permissions": ["alarms", "storage", "tabs", "notifications"],
  "host_permissions": [
    "https://www.zhipin.com/*",
    "http://127.0.0.1:43127/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "成都岗位采集助手",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.zhipin.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "128": "icon.svg"
  }
}
