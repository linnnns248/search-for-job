{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linnnns248.github.io/search-for-job/schemas/job.schema.json",
  "title": "Public job dataset",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "isDemo", "jobs"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "isDemo": { "type": "boolean" },
    "jobs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "company", "companySize", "companySizeMin", "title", "description", "salary", "city", "sources", "firstSeenAt", "lastSeenAt", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "company": { "type": "string", "minLength": 1 },
          "companySize": { "type": "string", "minLength": 1 },
          "companySizeMin": { "type": "integer", "minimum": 0 },
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "salary": { "type": "string" },
          "salaryMinK": { "type": ["number", "null"] },
          "salaryMaxK": { "type": ["number", "null"] },
          "city": { "type": "string", "minLength": 1 },
          "sources": { "type": "array", "minItems": 1 },
          "firstSeenAt": { "type": "string", "format": "date-time" },
          "lastSeenAt": { "type": "string", "format": "date-time" },
          "status": { "enum": ["new", "active", "updated", "suspected_offline", "offline"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
